{
  "name": "api-vendas-node",
  "version": "1.0.0",
  "author": "Emmanuel Molleri Velho",
  "description": "aprendizados com node js sobre API's",
  "main": "index.js",
  "scripts": {
    "dev": "NODE_ENV=development nodemon src/app.js",
    "start": "NODE_ENV=production node src/app.js",
    "start:dev": "NODE_ENV=development node src/app.js",
    "debug": "NODE_ENV=development ndb src/app.js",
    "test": "NODE_ENV=test jest --passWithNoTests",
    "test:watch": "NODE_ENV=test jest --watch --passWithNoTests",
    "test:coverage": "NODE_ENV=test jest --coverage --passWithNoTests",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "prettier": "prettier --check src/**/*.js",
    "prettier:fix": "prettier --write src/**/*.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:create": "npx sequelize-cli migration:generate",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:create": "npx sequelize-cli seed:generate",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose down",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "ajv": "8.17.1",
    "bcryptjs": "^3.0.3",
    "cors": "2.8.5",
    "dotenv": "^17.2.3",
    "express": "5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.1",
    "pg": "^8.16.3",
    "sequelize": "6.37.7",
    "sqlite3": "5.1.7",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
